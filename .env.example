# Variáveis de ambiente para o envio de e-mail (Netlify Function)
# Copie este arquivo para ".env" e preencha com seus dados.
# NUNCA suba o arquivo ".env" para o repositório.

# Servidor SMTP (exemplo com Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# Para onde os contatos do site serão enviados
# (se não definir, usa o SMTP_USER)
CONTACT_TO=seu-email@gmail.com
